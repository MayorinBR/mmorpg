# =============================
# Addressables (if used later)
# =============================
[Aa]ssets/[Aa]ddressable[Aa]ssets[Dd]ata/*/*.bin*
[Aa]ssets/[Aa]ddressable[Aa]ssets[Dd]ata/AssetGroups/*/*.bin*

# =============================
# Never ignore these Unity meta files
# =============================
!/[Aa]ssets/**/*.meta

# =============================
# Local backups of original assets
# =============================
/Backups/

# =============================
# Files generated by Claude sessions
# =============================
/Claude outputs/

