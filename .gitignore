# =============================
# OS-generated files
# =============================
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# =============================
# Unity crash logs
# =============================
sysinfo.txt

# =============================
# Addressables (if used later)
# =============================
[Aa]ssets/[Aa]ddressable[Aa]ssets[Dd]ata/*/*.bin*
[Aa]ssets/[Aa]ddressable[Aa]ssets[Dd]ata/AssetGroups/*/*.bin*

# =============================
# Never ignore these Unity meta files
# =============================
!/[Aa]ssets/**/*.meta
